#!/bin/bash
# lwts-smoke [--shots] : open every Settings section/tab through the launcher IPC and report new WARN/ERROR lines of the shell log.
# Prints one line per section: tabs visited + problems. --shots also saves ~/.cache/lwts/shots/smoke-<sec>-<tab>.png (screen area behind
# the panel is captured too - look at them yourself, do not leave them lying around).
# Tab counts come from the tab(...) rows of SettingsNew.qml (a section without tab(...) = 1 page).
Q="$HOME/.config/quickshell/lwts/settings/SettingsNew.qml"
SHOTS=0; [ "$1" = "--shots" ] && SHOTS=1
mkdir -p "$HOME/.cache/lwts/shots"
mapfile -t COUNTS < <(awk '/^    \{ id: "/ { if (n) print c; n=1; c=0 } /tab\("/ && n { c++ } END { print c }' "$Q")
NAMES=(Pinned Appearance Features Sound Network Devices Input Notifications Apps Gaming System)
# Pinned is built in code, not in rawBody: it comes first with one page
COUNTS=(1 "${COUNTS[@]}")
# no mouse move: ydotool --absolute passes the (0,0) hot corner and opens the niri overview (D99)
qs -c lwts ipc call launcher toggle >/dev/null; sleep 0.8
before=$(qs -c lwts log 2>&1 | wc -l)
bad=0
for ((s = 0; s < ${#COUNTS[@]}; s++)); do
  n=${COUNTS[$s]:-1}; [ "$n" -lt 1 ] && n=1
  for ((t = 0; t < n; t++)); do
    qs -c lwts ipc call launcher tab "$s" "$t" >/dev/null; sleep 0.7
    [ "$SHOTS" = 1 ] && grim -g "700,380 1100x800" "$HOME/.cache/lwts/shots/smoke-$s-$t.png"
  done
  new=$(qs -c lwts log 2>&1 | tail -n +"$((before + 1))" | grep -E 'WARN|ERROR' )
  if [ -n "$new" ]; then echo "FAIL ${NAMES[$s]} ($n tabs)"; echo "$new" | head -5; bad=1; before=$(qs -c lwts log 2>&1 | wc -l)
  else echo "ok   ${NAMES[$s]} ($n tabs)"; fi
done
qs -c lwts ipc call launcher toggle >/dev/null
exit $bad
