// Event sounds. The library is ~/.local/share/sounds/lwts/*.oga (generated by ~/.local/share/lwts/sound/gen_theme.lua = 8-bit tones and gen_keys.lua = piano / electric piano / pluck notes and the default phrases), named by
// how they sound (blip-rise, coin-up, melody-down...). Each shell event has a default sound (below); Settings -> Sound -> System sounds
// can mute it or point it at any library sound / own file from ~/.local/share/sounds/custom.
// Keys in settings.toml: `sound_theme` (anything but "off" = on), `sound_volume` (%), `sound_muted` (event ids), `sound_map` ("event=path").
// Played with pw-play: no resident process. Sources (all events, no polling): notifications (Notifs.qml), OSD volume pops,
// UPower charger, a fresh boot, and `qs -c lwts ipc call sounds play <event>` for scripts (screenshot bind).
pragma Singleton
import QtQuick
import Quickshell
import Quickshell.Io
import Quickshell.Services.UPower
import qs.core
import qs.services

Singleton {
  id: root
  readonly property string lib: Quickshell.env("HOME") + "/.local/share/sounds/lwts"
  readonly property bool on: Prefs.get("sound_theme", "lwts") !== "off"
  readonly property string pack: Prefs.get("sound_pack", "keys")
  readonly property int volume: Number(Prefs.get("sound_volume", 80))
  readonly property var muted: Prefs.get("sound_muted", [])
  // the events the shell itself plays: [id, label, group]
  readonly property var events: [
    ["message-new-instant", "Notification", "Notifications"], ["dialog-warning", "Urgent notification", "Notifications"],
    ["power-plug", "Charger connected", "Power"], ["power-unplug", "Charger removed", "Power"],
    ["audio-volume-change", "Volume change", "Actions"], ["screen-capture", "Screenshot", "Actions"],
    ["desktop-login", "Shell started after boot", "Session"],
    ["window-open", "Window opened", "Windows"], ["window-close", "Window closed", "Windows"],
    ["workspace-change", "Workspace switched", "Workspaces"], ["monitor-focus", "Moved to another monitor", "Workspaces"]]
  readonly property var groups: ["Notifications", "Power", "Actions", "Session", "Windows", "Workspaces"]
  // the window and workspace sounds fire all day: they stay off until the user switches them on (sound_enabled)
  readonly property var offByDefault: ["window-open", "window-close", "workspace-change", "monitor-focus"]
  // packs = a default sound for every event (Settings -> System sounds -> Pack): keys = piano / synth, glass = soft macOS / iOS-like, retro = 8-bit
  readonly property var packs: ({
    keys:  { "message-new-instant": "piano-rise", "dialog-warning": "piano-low-alert", "power-plug": "piano-fifth-up", "power-unplug": "piano-fifth-down",
             "audio-volume-change": "piano-tick", "screen-capture": "pluck-snap", "desktop-login": "piano-arpeggio-up",
             "window-open": "pluck-e5", "window-close": "pluck-c5", "workspace-change": "ep-g4", "monitor-focus": "ep-c5" },
    glass: { "message-new-instant": "glass-tap", "dialog-warning": "low-fall", "power-plug": "ping-up", "power-unplug": "soft-pop",
             "audio-volume-change": "wood-tick", "screen-capture": "snap-click", "desktop-login": "sparkle-up",
             "window-open": "tiny-tink", "window-close": "keycap-tap", "workspace-change": "purr-low", "monitor-focus": "funk-thud" },
    retro: { "message-new-instant": "blip-rise", "dialog-warning": "alarm-two-tone", "power-plug": "coin-up", "power-unplug": "coin-down",
             "audio-volume-change": "tick", "screen-capture": "shutter", "desktop-login": "melody-up",
             "window-open": "ping", "window-close": "soft-fall", "workspace-change": "arp-up", "monitor-focus": "double-ping" } })
  function defaultOf(event) { const m = packs[pack] || packs.keys; return m[event] ? lib + "/" + m[event] + ".oga" : "" }

  // per-event choice: "off" (muted) | "" (default sound) | a file path; stored as `sound_map = ["event=path"]`
  readonly property var map: { const m = {}; for (const r of Prefs.get("sound_map", [])) { const i = r.indexOf("="); if (i > 0) m[r.slice(0, i)] = r.slice(i + 1) } return m }
  readonly property var enabled: Prefs.get("sound_enabled", [])
  function isOff(event) { return muted.indexOf(event) >= 0 || (offByDefault.indexOf(event) >= 0 && enabled.indexOf(event) < 0) }
  function choiceOf(event) { return isOff(event) ? "off" : (map[event] || "") }
  function setChoice(event, v) {
    const l = Prefs.get("sound_muted", []).filter(x => x !== event), mp = Prefs.get("sound_map", []).filter(x => !x.startsWith(event + "="));
    const en = Prefs.get("sound_enabled", []).filter(x => x !== event);
    if (v === "off") l.push(event); else { if (v) mp.push(event + "=" + v); if (offByDefault.indexOf(event) >= 0) en.push(event) }
    Prefs.setMany({ sound_muted: l, sound_map: mp, sound_enabled: en });
  }
  function groupOn(g) { return events.some(e => e[2] === g && !isOff(e[0])) }
  function setGroup(g, on) {   // one switch for a whole group; the custom sound of each event is kept
    const l = Prefs.get("sound_muted", []).filter(x => events.every(e => e[2] !== g || e[0] !== x)), en = Prefs.get("sound_enabled", []).filter(x => events.every(e => e[2] !== g || e[0] !== x));
    for (const e of events) if (e[2] === g) { if (!on) l.push(e[0]); else if (offByDefault.indexOf(e[0]) >= 0) en.push(e[0]) }
    Prefs.setMany({ sound_muted: l, sound_enabled: en });
  }
  function egg(name) { playFile(lib + "/" + name + ".oga") }   // Easter egg sounds (gen_casino.py): the long scroll in the pickers; follows the master switch and volume
  function playFile(path) {
    if (!on || !path) return;
    Quickshell.execDetached(["pw-play", "--volume", String(Math.max(0.05, volume / 100)), path]);
  }
  function play(event, force) {
    if (!on || !event || (!force && isOff(event))) return;
    playFile(map[event] || defaultOf(event));
  }
  // every sound a user can pick, grouped: own files (★) first, then the current pack, then the other packs. The 111 single piano / ep / pluck
  // notes are hidden unless `sound_notes` is on (a note that is already in use stays visible). Groups come from manifest-<pack>.tsv, written by gen_*.py.
  property var all: []     // [{ pack, kind, name, path }]
  readonly property bool notes: Prefs.get("sound_notes", false) === true
  readonly property var files: {   // [[path, label]]
    const used = Object.values(map), order = p => p === "custom" ? 0 : p === pack ? 1 : p === "keys" ? 2 : p === "glass" ? 3 : 4;
    const tag = { keys: "Keys", glass: "Glass", retro: "Retro" };
    return all.filter(x => x.kind !== "note" || notes || used.indexOf(x.path) >= 0)
              .sort((a, b) => order(a.pack) - order(b.pack) || a.name.localeCompare(b.name))
              .map(x => [x.path, x.pack === "custom" ? "\u2605 " + x.name : tag[x.pack] + " \u00B7 " + x.name.replace(/-([a-g])s(\d)$/, "-$1#$2").replace(/-/g, " ")]);
  }
  function scan() { scanProc.running = true }
  Process {
    id: scanProc
    command: ["sh", "-c", 'cat "$HOME"/.local/share/sounds/lwts/manifest-*.tsv 2>/dev/null; '
      + 'find "$HOME/.local/share/sounds/custom" -maxdepth 2 -type f \\( -name "*.oga" -o -name "*.ogg" -o -name "*.wav" -o -name "*.mp3" -o -name "*.flac" \\) 2>/dev/null | sort | sed "s/^/custom\tphrase\t/"']
    stdout: StdioCollector { onStreamFinished: {
      root.all = text.trim().split("\n").filter(l => l.includes("\t")).map(l => {
        const [pack, kind, n] = l.split("\t");
        return pack === "custom" ? { pack, kind, name: n.split("/").pop().replace(/\.[^.]+$/, ""), path: n }
                                 : { pack, kind, name: n, path: root.lib + "/" + n + ".oga" } });
    } }
  }
  Component.onCompleted: scan()

  property bool ready: false
  Timer { interval: 4000; running: true; onTriggered: root.ready = true }   // no sounds for the values read at startup
  property bool tick: true
  Timer { id: tickGap; interval: 140; onTriggered: root.tick = true }
  Connections {
    target: OsdState
    function onPopped() { if (OsdState.kind === "volume" && root.tick) { root.tick = false; tickGap.restart(); root.play("audio-volume-change") } }
  }
  // window / workspace sounds from the compositor's own events (no polling); a quick burst makes one sound, not twenty
  property var lastAt: ({})
  function rate(event, gap) { const t = Date.now(); if (t - (lastAt[event] || 0) < gap) return false; lastAt[event] = t; return true }
  Connections {
    target: Compositor
    function onWindowOpened() { if (root.ready && root.on && root.rate("window-open", 150)) root.play("window-open") }
    function onWindowClosed() { if (root.ready && root.on && root.rate("window-close", 150)) root.play("window-close") }
    function onFocusedWorkspaceIdChanged() { if (root.ready && root.on && root.rate("workspace-change", 120)) root.play("workspace-change") }
    function onOutputFocused() { if (root.ready && root.on && root.rate("monitor-focus", 300)) root.play("monitor-focus") }
  }
  Connections {
    target: UPower
    function onOnBatteryChanged() { if (root.ready) root.play(UPower.onBattery ? "power-unplug" : "power-plug") }
  }
  Process {   // a fresh boot only (not every shell reload)
    running: true
    command: ["sh", "-c", "awk '{print ($1 < 150)}' /proc/uptime"]
    stdout: StdioCollector { onStreamFinished: if (text.trim() === "1") root.play("desktop-login") }
  }
}
