// Rendered from ~/.config/themes/templates/fastfetch.jsonc by ~/.config/themes/theme.py — edit the template.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "small",
        "color": {
            "1": "38;2;{{colors.primary.default.red}};{{colors.primary.default.green}};{{colors.primary.default.blue}}",
            "2": "38;2;{{colors.on_surface.default.red}};{{colors.on_surface.default.green}};{{colors.on_surface.default.blue}}"
        },
        "padding": {
            "top": 1,
            "right": 6
        }
    },
    "display": {
        "separator": " -> ",
        "brightColor": false,
        "color": {
            "keys": "38;2;{{colors.primary.default.red}};{{colors.primary.default.green}};{{colors.primary.default.blue}}",
            "title": "38;2;{{colors.tertiary.default.red}};{{colors.tertiary.default.green}};{{colors.tertiary.default.blue}}",
            "separator": "38;2;{{colors.outline.default.red}};{{colors.outline.default.green}};{{colors.outline.default.blue}}",
            "output": "38;2;{{colors.on_surface.default.red}};{{colors.on_surface.default.green}};{{colors.on_surface.default.blue}}"
        },
        "key": {
            "width": 12
        }
    },
    "modules": [
        {
            "type": "custom",
            "outputColor": "38;2;{{colors.outline.default.red}};{{colors.outline.default.green}};{{colors.outline.default.blue}}",
            "format": "╭──────────────────────────────────────────────╮"
        },
        {
            "type": "title",
            "key": "│ user       ",
            "format": "{user-name}"
        },
        {
            "type": "host",
            "key": "│ host       "
        },
        {
            "type": "os",
            "key": "│ os         "
        },
        {
            "type": "kernel",
            "key": "│ kernel     "
        },
        {
            "type": "packages",
            "key": "│ packages   "
        },
        {
            "type": "terminal",
            "key": "│ terminal   "
        },
        {
            "type": "de",
            "key": "│ de         "
        },
        {
            "type": "wm",
            "key": "│ wm         "
        },
        {
            "type": "uptime",
            "key": "│ uptime     "
        },
        {
            "type": "cpu",
            "key": "│ cpu        ",
            "format": "{name}"
        },
        {
            "type": "gpu",
            "key": "│ gpu        ",
            "format": "{name}"
        },
        {
            "type": "memory",
            "key": "│ memory     "
        },

        {
            "type": "custom",
            "outputColor": "38;2;{{colors.outline.default.red}};{{colors.outline.default.green}};{{colors.outline.default.blue}}",
            "format": "╰──────────────────────────────────────────────╯"
        }
    ]
}






