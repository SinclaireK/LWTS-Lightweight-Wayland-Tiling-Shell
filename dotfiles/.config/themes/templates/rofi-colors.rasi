/* Generated by ~/.config/themes/theme.py ({{theme.name}}). Do not edit by hand. */
* {
    bg:         {{colors.surface.default.hex}}{{ui.alpha_hex}};
    bg-solid:   {{colors.surface.default.hex}};
    bg-alt:     {{colors.on_surface.default.hex}}1f;
    fg:         {{colors.on_surface.default.hex}};
    fg-dim:     {{colors.on_surface_variant.default.hex}};
    accent:     {{colors.primary.default.hex}};
    on-accent:  {{colors.on_primary.default.hex}};
    sel:        {{colors.primary_container.default.hex}}b3;
    on-sel:     {{colors.on_primary_container.default.hex}};
    border-col: {{colors.outline_variant.default.hex}};
    urgent:     {{colors.error.default.hex}};
}

configuration { font: "{{ui.font}} {{ui.size_pt}}"; }
